{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "timer",
      "type": "timerTrigger",
      "direction": "in",
      "schedule": "0 30 1 * * *",
      "runOnStartup": false
    },
    {
      "name": "message",
      "type": "queue",
      "direction": "out",
      "queueName": "%REPORT_QUEUE%",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
